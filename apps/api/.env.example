# ==================== AirB-n-Bark API - Environment Variables ====================

# Server Configuration
PORT=3001
NODE_ENV=development  # development | production | test

# Database (PostgreSQL)
# Pour développement local:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/airbnbark
# Pour Docker (port 5143 exposé):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5143/airbnbark

# JWT Configuration
JWT_SECRET=airbonbark-dev-secret-key-2026-x7k9m2p4q8r1s5t3
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Comma-separated origins
# Ajoute ton IP locale pour tester sur mobile (ex: 192.168.1.XX)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_MAX=100            # Max requests per window
