# ==================== AIRB-N-BARK FRONTEND CONFIG ====================

# Toggle API/Mock
# 'true' = utilise l'API backend réelle
# Autre valeur = mode simulation locale (par défaut)
VITE_USE_API=true

# URL de l'API backend (utilise l'IP locale pour accès depuis téléphone)
# Pour accès local uniquement: http://localhost:3001/api
# Pour accès depuis téléphone: http://192.168.1.49:3001/api
VITE_API_URL=http://192.168.1.49:3001/api