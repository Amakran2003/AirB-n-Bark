:80 {
  # API reverse proxy
  handle /api/* {
    reverse_proxy api:3000
  }
  
  # Frontend avec cache headers
  handle {
    reverse_proxy web:5173
    
    # Cache pour les assets statiques (1 an)
    @assets {
      path *.js *.css *.woff *.woff2 *.png *.jpg *.jpeg *.svg *.ico *.webp *.avif
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"
    
    # Cache court pour HTML et SW
    @html {
      path *.html
    }
    header @html Cache-Control "no-cache, must-revalidate"
  }
}

# Prisma Studio (dev only)
:5555 {
  reverse_proxy api:5555
}