# ==================== AirB-n-Bark - Root Environment Variables ====================
# Ce fichier est utilisé par docker-compose pour configurer tous les services
# ⚠️ NE PAS COMMITER CE FICHIER EN PRODUCTION - Utiliser des secrets Docker/Kubernetes

# ==================== DATABASE ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airbnbark
DB_EXTERNAL_PORT=5433

# ==================== API ====================
API_PORT=3000
NODE_ENV=development

# JWT - ⚠️ CHANGER EN PRODUCTION!
JWT_SECRET=airbonbark-dev-secret-key-2026-x7k9m2p4q8r1s5t3

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173

# ==================== FRONTEND ====================
WEB_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_USE_API=true

# ==================== STRIPE ====================
# Obtenir vos cles sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique

# ==================== INFRASTRUCTURE ====================
CADDY_PORT=80
REDIS_PORT=6379
