# ==================== AirB-n-Bark - Environment Variables ====================
# Copier ce fichier en .env et remplir les valeurs
# ⚠️ NE JAMAIS COMMITER LE FICHIER .env AVEC DES SECRETS RÉELS

# ==================== DATABASE ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=airbnbark
DB_EXTERNAL_PORT=5433

# ==================== API ====================
API_PORT=3000
NODE_ENV=development

# JWT - ⚠️ OBLIGATOIRE (min 32 caractères)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==================== FRONTEND ====================
WEB_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_USE_API=true

# ==================== INFRASTRUCTURE ====================
CADDY_PORT=80
REDIS_PORT=6379
